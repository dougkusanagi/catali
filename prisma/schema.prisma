generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Promotion {
  id        Int       @id @default(autoincrement())
  title     String    @default("Ofertas da semana")
  subtitle  String    @default("Preço de atacado para você economizar de verdade")
  note      String    @default("Ofertas válidas enquanto durarem os estoques")
  badgeText String    @default("ATACADO")
  hashtag   String    @default("#VEMPROCRÔNICAS")
  version   Int       @default(1)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PromotionHistory {
  id               Int       @id @default(autoincrement())
  promotionVersion Int
  snapshot         String
  createdAt        DateTime  @default(now())
}

model Product {
  id                  Int       @id @default(autoincrement())
  imagePath           String
  wholesalePriceCents Int
  position            Int       @default(0)
  promotionId         Int
  promotion           Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
