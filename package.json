{
  "name": "cj-promo-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c red,yellow \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "vp dev --host 0.0.0.0 --port 5199",
    "dev:api": "bun --watch server/index.js",
    "start": "bun server/index.js",
    "build": "vp build",
    "lint": "vp lint",
    "check": "vp check",
    "preview": "vp preview",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:generate": "bunx --bun prisma generate",
    "db:seed": "bun prisma/seed.js"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.4",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-easy-crop": "^6.2.3",
    "react-image-crop": "^11.1.2",
    "react-number-format": "^5.4.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "prisma": "^7.9.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
